# Bili Acoustic — biến môi trường
# Hiện tại website KHÔNG cần biến nào. Website chạy tĩnh hoàn toàn.
#
# Các tên dưới đây chỉ dành cho lúc thêm backend (thanh toán, đăng nhập, email).
# KHÔNG điền giá trị thật vào file này và KHÔNG commit giá trị thật.
#   - Trên Cloudflare: Settings → Variables and Secrets (chọn "Encrypt").
#   - Ở máy local (Pages Functions / wrangler): tạo file .dev.vars (đã có trong .gitignore).
#
# Lưu ý: biến có tiền tố VITE_ sẽ bị nhúng vào JavaScript công khai.
# Chỉ dùng VITE_ cho giá trị KHÔNG bí mật.

# --- Cổng thanh toán (ví dụ PayOS) — chỉ dùng phía server ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# --- Gửi email (form liên hệ) — chỉ dùng phía server ---
EMAIL_API_KEY=
CONTACT_TO_EMAIL=

# --- Cloudflare Turnstile (chống spam) ---
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
